<Project>
  <!-- Shared settings for every plugin project. Each plugin sets PluginId and Version and ships a plugin.json. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is always resolved from the host; never ship it with the plugin. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Vigia.Plugins.Abstractions\Vigia.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
